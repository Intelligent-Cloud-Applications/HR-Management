{
  "name": "hr-management-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless employee APIs, Cognito invites, and DynamoDB tables for TekkzyWork.",
  "scripts": {
    "deploy": "serverless deploy --region us-east-2 --stage dev",
    "remove": "serverless remove --region us-east-2 --stage dev",
    "logs": "serverless logs -f api --region us-east-2 --stage dev --tail"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.901.0",
    "@aws-sdk/client-dynamodb": "^3.901.0",
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/lib-dynamodb": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "aws-jwt-verify": "^5.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.55.1"
  }
}
